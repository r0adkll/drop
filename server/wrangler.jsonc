// Deployment-specific values (database ID, bucket name, route) are placeholders: each adopter
// replaces them for their own Cloudflare account. Everything else comes from drop.config.json.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drop",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drop",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUILDS",
      "bucket_name": "drop-builds"
    }
  ],
  "vars": {
    // Must match r2_buckets[0].bucket_name: presigned upload URLs address the bucket by name.
    "R2_BUCKET_NAME": "drop-builds"
  },
  // Set with `wrangler secret put`; see README.md.
  "secrets": {
    "required": ["R2_ACCOUNT_ID", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY"]
  },
  "triggers": {
    // Retention runs hourly; see docs/design.md#retention.
    "crons": ["0 * * * *"]
  }
}
